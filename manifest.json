{
  "manifest_version": 3,
  "name": "Stealth Split Browser",
  "version": "1.5.3",
  "description": "1つのタブを分割して2サイトを同時閲覧。ペインごとにモノクロ/画像非表示。ブックマーク・広告ブロック対応。",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stealth Split Browser"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "commands": {
    "open-splitter": {
      "suggested_key": { "default": "Alt+X" },
      "description": "分割画面を開く"
    },
    "toggle-left": {
      "suggested_key": { "default": "Alt+C" },
      "description": "左ペインを隠す/復元"
    },
    "toggle-right": {
      "suggested_key": { "default": "Alt+V" },
      "description": "右ペインを隠す/復元"
    },
    "toggle-monochrome": {
      "suggested_key": { "default": "Alt+M" },
      "description": "モノクロ表示をトグル（全タブ対象）"
    },
    "toggle-bookmark-bar": {
      "description": "ブックマークバーの表示/非表示をトグル (推奨: Alt+S, 手動バインド)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_unblock",
        "enabled": true,
        "path": "rules/frame_unblock.json"
      },
      {
        "id": "adblock",
        "enabled": true,
        "path": "rules/adblock.json"
      }
    ]
  }
}
